{
  "projectType": "saas",
  "projectName": "Mintlify",
  "projectDescription": "Mintlify is a documentation platform that lets teams build beautiful, AI-powered docs sites from MDX files with zero infrastructure overhead.",
  "theme": "luma",
  "primaryColor": "#ef7025",
  "lightColor": "#eec9bc",
  "darkColor": "#4fa1ab",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "getting-started/account-setup",
              "getting-started/connect-github"
            ]
          },
          {
            "group": "Writing Docs",
            "pages": [
              "writing/pages-and-structure",
              "writing/components",
              "writing/code-blocks",
              "writing/images-and-media"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/docs-json",
              "configuration/navigation",
              "configuration/branding",
              "configuration/custom-domain"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "features/ai-search",
              "features/analytics",
              "features/versioning",
              "features/localization"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/github",
              "integrations/api-references",
              "integrations/mcp"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Common Tasks",
            "pages": [
              "guides/migrating-to-mintlify",
              "guides/openapi-setup",
              "guides/custom-components",
              "guides/team-collaboration"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "troubleshooting/deployment-issues",
              "troubleshooting/faq"
            ]
          }
        ]
      }
    ]
  },
  "keyFeatures": [
    "MDX-based documentation pages with rich component library",
    "AI-powered search and chat across documentation",
    "GitHub-native workflow — push to deploy",
    "OpenAPI / Swagger integration for auto-generated API references",
    "Custom branding, themes, and custom domain support",
    "Analytics dashboard to understand reader engagement",
    "Versioning and localization support",
    "MCP (Model Context Protocol) server for AI agent integration"
  ],
  "publicApiSurface": [
    "docs.json — site configuration schema",
    "mint dev — local development CLI command",
    "mint validate — configuration validation CLI command",
    "mint broken-links — broken link checker CLI command",
    "npx skills add — AI-assisted writing command",
    "MDX frontmatter fields: title, description, icon, sidebarTitle",
    "Navigation schema: tabs, groups, pages, anchors, dropdowns",
    "Component library: Card, CardGroup, CodeBlock, Tabs, Steps, Callout, Accordion, Frame, Tooltip, Snippet"
  ]
}
